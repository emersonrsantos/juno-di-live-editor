{
  "name": "juno-di-editor",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "desktop": "vite build && electron .",
    "dist:win": "vite build && electron-builder --win"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "@xmldom/xmldom": "0.8.10",
    "electron": "^33.2.1",
    "electron-builder": "^25.1.8",
    "typescript": "5.6.3",
    "vite": "5.4.11",
    "vitest": "2.1.8"
  },
  "allowScripts": {
    "electron@33.2.1": true
  },
  "description": "JUNO-Di Editor - a modern replacement for Roland JUXE.exe",
  "main": "electron/main.cjs",
  "build": {
    "appId": "local.juno-di-editor",
    "productName": "JUNO-Di Editor",
    "files": [
      "dist/**/*",
      "electron/**/*",
      "package.json"
    ],
    "directories": {
      "output": "release"
    },
    "win": {
      "target": [
        "nsis",
        "portable"
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true
    },
    "portable": {
      "artifactName": "${productName}-${version}-portable.exe"
    }
  }
}
